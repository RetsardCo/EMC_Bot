# Automatic OpenRouter free coding model discovery
OPENROUTER_AUTO_DISCOVERY=true
OPENROUTER_AUTO_REFRESH_SECONDS=21600
OPENROUTER_MODEL_CACHE_FILE=data/openrouter_model_cache.json

# Used only if automatic discovery cannot find a free coding model.
OPENROUTER_CODING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Last-resort OpenRouter free router.
OPENROUTER_FREE_CODING_FALLBACK=openrouter/free

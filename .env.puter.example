# Puter server-side fallback
# Create this token in your Puter account dashboard.
PUTER_AUTH_TOKEN=YOUR_PUTER_AUTH_TOKEN
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/
PUTER_MODEL=gpt-5.4-nano
PUTER_DAILY_MODEL=gpt-5.4-nano

# Daily source weighting
# Each successfully retrieved website source gets this weight.
# Reference-book weights are managed from the Knowledge Manager GUI.
DAILY_WEBSITE_SOURCE_WEIGHT=10
